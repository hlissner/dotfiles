#!/usr/bin/env zsh
# Stand-in for hyprctl, for test/hey/wm.janet. A query (-j WORDS...) is
# answered from $HEY_TEST_WM_FIXTURES/hypr/WORDS-joined-by-dashes.json, trying
# a -$HEY_TEST_WM_VARIANT suffix first; anything else is logged to
# $HEY_TEST_WM_LOG and succeeds.
if [[ $1 == -j ]]; then
  shift
  local base=$HEY_TEST_WM_FIXTURES/hypr/${(j:-:)@}
  local f=$base${HEY_TEST_WM_VARIANT:+-$HEY_TEST_WM_VARIANT}.json
  [[ -f $f ]] || f=$base.json
  [[ -f $f ]] || { print -u2 "no fixture: $f"; exit 1 }
  cat $f
else
  print -r -- "hyprctl $*" >>$HEY_TEST_WM_LOG
fi
