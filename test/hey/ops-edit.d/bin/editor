#!/usr/bin/env zsh
# Stand-in for $EDITOR, for test/hey/ops-edit.janet. Appends $HEY_OPS_TEST_EDIT
# to every file it's handed, or touches nothing if that's empty, then exits
# $HEY_OPS_TEST_EDITOR_EXIT -- the :cq an editor uses to say "forget it".
local f
for f in "$@"; do
  [[ -n $HEY_OPS_TEST_EDIT ]] && print -r -- "$HEY_OPS_TEST_EDIT" >>$f
done
exit ${HEY_OPS_TEST_EDITOR_EXIT:-0}
