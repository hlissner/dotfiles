# modules/wm/niri/default.nix
#
# After a month or so of imposing an everything-scrolling layout on Hyprland,
# I'm trying Niri...

{ self, lib, config, pkgs, ... }:

with lib;
with self.lib;
let cfg = config.modules.wm.niri;
    theme = config.modules.wm.theme;
in {
  options.modules.wm.niri = with types; {
    extraConfig = mkOpt' lines ""
      "KDL appended to the generated config.kdl, after config/niri/ and the outputs.";
    monitors = mkOpt' (listOf (submodule {
      options = {
        output = mkOpt' str "" ''A connector ("DP-1") or "Make Model Serial".'';
        primary = mkOpt' bool false
          "focus-at-startup, and where the named workspaces open. Niri has no other notion of primary.";
        off = mkOpt bool false;
        mode = mkOpt' (nullOr str) null
          ''"WxH" or "WxH@Hz"; Hz must match `niri msg outputs` to three decimals.'';
        scale = mkOpt (nullOr (either int float)) null;
        transform = mkOpt (nullOr (enum [
          "normal" "90" "180" "270" "flipped" "flipped-90" "flipped-180" "flipped-270"
        ])) null;
        position = mkOpt' (nullOr (submodule {
          options = { x = mkOpt int 0; y = mkOpt int 0; };
        })) null "Logical pixels; null lets niri place it.";
        vrr = mkOpt' (either bool (enum [ "on-demand" ])) false
          ''true always; "on-demand" pairs with the variable-refresh-rate window rule.'';
        backdropColor = mkOpt (nullOr str) null;
        hotCorners = mkOpt' (nullOr (listOf (enum [
          "top-left" "top-right" "bottom-left" "bottom-right"
        ]))) null "null inherits gestures.hot-corners; [] is off.";
        layout = mkOpt' lines "" "Raw KDL for this output's layout {} override.";
        extraConfig = mkOpt' lines "" "Raw KDL for anything else (modeline, mode custom=true).";
      };
      # [] rather than hyprland's [{}]: `output ""` is a config error, and an
      # empty list is how you let niri autodetect.
    })) [] "Outputs, rendered one `output` block each.";
  };

  config = mkIf (config.modules.wm.desktop == "niri") (mkMerge [
    ## The compositor.
    (let primary = findFirst (x: x.primary) {} cfg.monitors;
     in {
      programs.niri.enable = true;

      environment.systemPackages = [ pkgs.xwayland-satellite ]; # required for xwayland windows

      modules.wm = {
        primaryMonitor = primary.output or null;
        outputs = filter (o: o != "") (catAttrs "output" cfg.monitors);
        session = {
          name = "niri";
          desktopName = "Niri";
          unit = "niri.service";
          command = "${config.programs.niri.package}/bin/niri-session";
        };
      };

      hey.info.niri = {
        primaryMonitor = primary.output or null;
        monitors = cfg.monitors;
        version = config.programs.niri.package.version;
      };
    })

    ## Its config: config/niri/, entered through a generated config.kdl.
    (let
      primary = findFirst (x: x.primary) {} cfg.monitors;
      colorsFile = "${config.home.configDir}/niri/colors.kdl";
      liveConfig = "${config.hey.configDir}/niri/config.kdl";

      num = v: if isFloat v then strings.floatToString v else toString v;
      block = name: lines: ''
        ${name} {
        ${concatMapStringsSep "\n" (l: "    ${l}") lines}
        }
      '';

      mkOutput = m: block ''output "${m.output}"'' (
           optional m.off "off"
        ++ optional (m.mode != null) ''mode "${m.mode}"''
        ++ optional (m.scale != null) "scale ${num m.scale}"
        ++ optional (m.transform != null) ''transform "${m.transform}"''
        ++ optional (m.position != null) "position x=${toString m.position.x} y=${toString m.position.y}"
        ++ optional (m.vrr == true) "variable-refresh-rate"
        ++ optional (m.vrr == "on-demand") "variable-refresh-rate on-demand=true"
        ++ optional m.primary "focus-at-startup"
        ++ optional (m.backdropColor != null) ''backdrop-color "${m.backdropColor}"''
        ++ optional (m.hotCorners != null)
             "hot-corners { ${if m.hotCorners == [] then "off" else concatMapStringsSep " " (c: "${c};") m.hotCorners} }"
        ++ optional (m.layout != "") "layout {\n${m.layout}\n}"
        ++ optional (m.extraConfig != "") m.extraConfig);

      # Named workspaces always exist, which is the nearest thing niri has to
      # hyprland's special workspaces; config/niri/config.kdl binds them by
      # name. They have to live on the primary or they land on whichever
      # output niri sorts first. The layout overrides are what the hyprland
      # workspace rules for special:media and special:pad did.
      mkWorkspace = name: layout: block ''workspace "${name}"'' (
           optional (primary ? output) ''open-on-output "${primary.output}"''
        ++ [ "layout {\n${layout}\n}" ]);

      text = ''
        // Auto-generated by nixos
        include "${liveConfig}"
        // Rendered by Noctalia (see theme.nix)
        include optional=true "${colorsFile}"

        cursor {
            xcursor-theme "${theme.cursor.name}"
            xcursor-size ${toString theme.cursor.size}
        }

        xwayland-satellite {
            path "${getExe pkgs.xwayland-satellite}"
        }

        ${concatMapStrings mkOutput cfg.monitors}
        ${mkWorkspace "media" ''
            gaps 0
            border { off; }
            shadow { off; }''}
        ${mkWorkspace "scratchpad" ''
            gaps 10
            struts { left 85; right 85; top 85; bottom 85; }
            default-column-width { proportion 0.4; }''}
        ${cfg.extraConfig}
      '';
    in {
      user.packages = with pkgs; [
        wooz   # for my zoom feature
      ];

      home.configFile."niri/config.kdl".text = text;

      # Validated against the store snapshot (the live include is rewritten;
      # the colors one is optional and absent), so a broken config/niri/ fails
      # `hey sync` rather than greeting me with niri's default config. This is
      # the one eval-time read of config/niri/, so it has to be git-added.
      system.extraDependencies = [
        (pkgs.runCommand "niri-config-check" {} ''
          ${getExe config.programs.niri.package} validate -c ${
            pkgs.writeText "niri-config-check.kdl"
              (replaceStrings [ liveConfig ] [ "${/. + "${self.configDir}/niri/config.kdl"}" ] text)}
          touch $out
        '')
      ];

      modules.shell.zsh.rcFiles = [ "${config.hey.configDir}/niri/aliases.zsh" ];

      modules.wm.theme.files.niri = {
        input_path = "${config.hey.configDir}/niri/colors.template.kdl";
        output_path = colorsFile;
        # niri polls its includes every 500ms anyway; this makes it immediate.
        post_hook = "niri msg action load-config-file";
      };
    })
  ]);
}
