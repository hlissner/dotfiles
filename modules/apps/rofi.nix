{ self, lib, config, options, pkgs, ... }:

with builtins;
with lib;
let inherit (self.lib.pkgs) mkWrapper mkLauncherEntry;
    cfg = config.modules.apps.rofi;
in {
  options.modules.apps.rofi = with self.lib.options; {
    enable = mkBoolOpt false;
  };

  config = mkIf cfg.enable (mkMerge [
    {
      modules.wm.theme.files.rofi = {
        input_path = "${config.hey.configDir}/rofi/colors.template.rasi";
        output_path = "${config.home.configDir}/rofi/themes/colors.rasi";
      };

      home.configLink."rofi" = "${config.hey.configDir}/rofi";

      home.configFile."rofi/themes/fonts.rasi".text =
        let fonts = config.hey.info.theme.fonts or {};
            var = name: family: i: size:
              ''  ${name}-${toString i}: "${family} ${toString size}";'';
        in ''
          /* Auto-generated by NixOS config; colors.rasi refers to these. */
          * {
          ${concatStringsSep "\n" (imap0 (var "font-mono" (fonts.mono or "monospace")) [ 10 12 14 16 20 ])}
          ${concatStringsSep "\n" (imap0 (var "font-sans" (fonts.sans or "sans-serif")) [ 14 16 18 22 ])}
          }
        '';

      programs.gdk-pixbuf.modulePackages = [ pkgs.librsvg ];

      environment.variables.ROFI_PLUGIN_PATH = [
        "${config.hey.configDir}/rofi/plugins"  # for local development
      ];

      user.packages = with pkgs; [
        rofi-unwrapped
        rofimoji
        (mkLauncherEntry "Open Bookmark ->" {
          description = "In ${config.modules.apps.browsers.default}";
          icon = "bookmark-new-symbolic";
          exec = "hey @rofi bookmarkmenu";
        })
        (mkLauncherEntry "Copy Icon ->" {
          icon = "icons";
          exec = "hey @rofi iconmenu";
        })
        (mkLauncherEntry "Emoji Selector ->" {
          icon = "face-smile";
          exec = "hey @rofi emojimenu";
        })
        (mkLauncherEntry "Open Vault ->" {
          icon = "bitwarden";
          exec = "hey @rofi vaultmenu";
        })
        (mkLauncherEntry "Power Menu ->" {
          icon = "system-shutdown";
          exec = "hey @rofi powermenu";
        })
      ];
    }
  ]);
}
