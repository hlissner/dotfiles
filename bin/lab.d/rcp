#!/usr/bin/env zsh
# rsync that honours .gitignore correctly.
#
# SYNOPSIS:
#   lab rcp [RSYNC_OPTS...] [--] SRC DST...
#
# DESCRIPTION:
#   rsync's filter language doesn't understand negation (`!`-prefixed rules)  in
#   gitignore files, so use fd to build the exclusion list before running rsync.
#   If SRC is a remote, fd>=9 must be installed there for this to work. Use
#   rsync directly otherwise.
#
# ARGUMENTS:
#   * PATH @files

setopt err_exit pipe_fail

local -a opts
while [[ $# -gt 0 && $1 == -* ]]; do
  [[ $1 == -- ]] && { shift; break }
  opts+=( "$1" ); shift
done
(( $# >= 2 )) || hey.abort "usage: lab rcp [RSYNC_OPTS...] SRC DST..."
local src=$1
local -a dsts=( "${@[2,-1]}" )

function ignored {
  local host= dir=$1
  if [[ $1 == *:* && $1 != /* ]]; then
    host=${1%%:*} dir=${1#*:}
  fi
  local fd='fd -H -t f -t l -t d'
  local walk="cd ${(q)${dir:-.}} && { $fd --no-require-git .; $fd --no-ignore .; } | sort | uniq -u"
  if [[ -n $host ]]; then ssh $host $walk; else eval $walk; fi \
    | awk '!p || index($0, p) != 1 { print "/" $0; p = $0 ~ /\/$/ ? $0 : $0 "/" }' \
    | sed 's/[][*?]/\\&/g'
}

[[ $src == *: ]] && src+=.
src=${src%/}/

local excludes
excludes=$(mktemp)
trap "rm -f $excludes" EXIT
ignored $src > $excludes || hey.abort "Couldn't walk $src; nothing synced"

local dst
for dst in "${dsts[@]}"; do
  hey.do rsync -rltDzPJ \
      --include=.git/ \
      --exclude-from=$excludes \
      --delete \
      --delete-after \
      "${opts[@]}" "$src" "$dst"
done
