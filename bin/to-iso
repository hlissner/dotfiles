#!/usr/bin/env zsh
# Pack files and directories into an ISO 9660 image.
#
# SYNOPSIS:
#   to-iso [-f] [-V LABEL] ISO PATH...
#
# DESCRIPTION:
#   A directory's contents land at the top level of the iso, so several
#   directories are merged into one tree. To nest one, graft it: `to-iso x.iso
#   roms/=snes/`.
#
# OPTIONS:
#   -f
#     Overwrite an existing iso.
#   -V LABEL
#     Volume label. Defaults to the iso's basename, sans extension.
#
# ARGUMENTS:
#   1 ISO @files
#   * PATH @files

setopt err_exit pipe_fail
zparseopts -D -F -- f=force V:=label || exit 1
(( $# >= 2 )) || hey.abort "Usage: to-iso [-f] [-V LABEL] ISO PATH..."

local iso=$1; shift
[[ $iso == *.iso ]] || iso+=.iso
[[ ! -e $iso || $force ]] || hey.abort "Exists (use -f): $iso"
hey.do -! xorriso -as mkisofs -quiet -graft-points \
  -J -R -iso-level 3 -V "${label[2]:-${iso:t:r}}" -o "$iso" "$@"
hey.echo "$iso <- $*"
