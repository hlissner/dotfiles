#!/usr/bin/env zsh
# hey.cache COMMAND [ARGS...]
#
# Caches COMMAND's output under $XDG_CACHE_HOME/zsh and sources it in
# interactive shells, regenerating it when the cache is missing or empty.

case $1 in
  [/~]*) [[ -x "$1" ]] || return 1 ;;
  *) (( $+commands[$1] )) || return 1 ;;
esac

local cache="$XDG_CACHE_HOME/zsh/${1:t}-${ZSH_VERSION}"
if [[ ! -s $cache ]]; then
  hey.echo -- "Caching ${1:t:r}..." >&2
  mkdir -p "${cache:h}"
  # Staged, so a generator that dies halfway can't leave partial output behind
  # for the next shell to source.
  local tmp="$cache.$$"
  if ! "$@" >"$tmp"; then
    rm -f "$tmp"
    hey.error "Failed to cache ${1:t:r}"
    return 1
  fi
  chmod 600 "$tmp"
  mv -f "$tmp" "$cache"
fi

if [[ -o interactive ]]; then
  source "$cache" || rm -f "$cache"
fi
