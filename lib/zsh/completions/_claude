# ---------------------------------------------------------------------------
# 4. Subcommands
# ---------------------------------------------------------------------------
# One function per row of the top-level Commands: table, in that order. The
# table itself is in _claude_commands, below them. Aliases (plugin|plugins,
# stop|kill, update|upgrade) are listed in _claude_commands and routed to the
# same function by the case at the end.

_claude_agents() {
  _arguments \
    '*--add-dir[Extra directory to allow in dispatched sessions]:directory:_directories' \
    '--agent[Default agent for dispatched sessions]:agent:__claude_agents' \
    '--all[With --json, include completed sessions]' \
    '--allow-dangerously-skip-permissions[Make bypass-permissions available to dispatched sessions]' \
    '--cwd[Only sessions started under this path]:path:_directories' \
    '--dangerously-skip-permissions[Alias for --permission-mode bypassPermissions]' \
    '--effort[Default effort for dispatched sessions]:level:('"$_claude_efforts"')' \
    '(-h --help)'{-h,--help}'[Display help]' \
    '--json[Print active sessions as JSON and exit]' \
    '*--mcp-config[MCP config for dispatched sessions]:config:_files -g "*.json"' \
    '--model[Default model for dispatched sessions]:model:__claude_models' \
    '--permission-mode[Default permission mode for dispatched sessions]:mode:('"$_claude_permission_modes"')' \
    '*--plugin-dir[Load plugins from this directory]:path:_directories' \
    '--restricted[Start dispatched sessions in restricted mode]' \
    '--setting-sources[Setting sources to load]:sources:_values -s , source '"$_claude_setting_sources" \
    '--settings[Settings file or JSON for the agent view and dispatched sessions]:file or json:_files -g "*.json"' \
    '--strict-mcp-config[Only use MCP servers from --mcp-config]'
}

_claude_attach()  { _arguments '1:session:__claude_sessions' }

_claude_auth() {
  local -a cmds=(
    'login:Sign in to your Anthropic account'
    'logout:Log out from your Anthropic account'
    'status:Show authentication status'
  )
  _arguments -C '(-h --help)'{-h,--help}'[Display help]' '1: :->cmd' '*:: :->args'
  case $state in
    cmd)  _describe -t commands 'auth command' cmds ;;
    args) _message 'no completion (see HOW TO REGENERATE)' ;;
  esac
}

