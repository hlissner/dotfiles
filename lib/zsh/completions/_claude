#compdef claude
#
# Completion for Claude Code's `claude` CLI, which ships none of its own: no
# `claude completion` subcommand, no _claude in the nixpkgs derivation (it is
# bin/ and nothing else). So this is transcribed by hand from --help, and will
# rot as releases add flags. That is the deal.
#
# TRANSCRIBED FROM: claude 2.1.266
#
# HOW TO REGENERATE
#
#   Everything below comes from three commands, in this order:
#
#     claude --help                 # section 3 (globals) and the command table
#     claude CMD --help             # sections 4-5, one function per CMD
#     claude CMD SUB --help         # mcp/plugin leaves (section 5)
#
#   Third-level help is broken in this build: `claude auth login --help` and
#   `claude plugin marketplace add -h` print the *top-level* help, and the
#   `claude auth help login` form starts an interactive session instead. So the
#   leaves under auth, auto-mode, project, plugin marketplace and plugin eval
#   carry only what their parent's Commands: table says about them (positional
#   arguments, no flags). Recheck that first; if it's fixed, fill them in.
#
#   `claude plugin list --json` was empty when this was written, so the jq in
#   __claude_plugins guesses at field names (.id, then .name). If it comes back
#   empty with plugins installed, print the JSON and fix the field.
#
#   Then: `hey sync` (this file is served out of the nix store) and `hey reload`
#   (drops the compdump, which compinit -C otherwise trusts).
#
# LAYOUT
#
#   1. Enumerations   -- value lists copied out of "(choices: ...)" in --help
#   2. Dynamic lookups -- __claude_* functions that ask the filesystem or claude
#   3. Global options  -- the top-level Options: table, verbatim order
#   4. Subcommands     -- one _claude_CMD per entry in the top-level Commands:
#   5. Nested groups   -- mcp, plugin, plugin marketplace, plugin eval
#   6. Main body      -- top-level dispatch; the file body is the function
#
# CONVENTIONS
#
#   Option specs are one per line, in --help's (alphabetical) order, so a diff
#   against a fresh --help is a straight read. Descriptions are shortened but
#   never reworded past recognition. A flag documented as "(repeatable)" or
#   `<x...>` gets a leading `*`. Flags that take an optional value (`[value]`)
#   are spelled `--flag=` in zsh: `--flag`, `--flag val` and `--flag=val` all
#   parse, and TAB does not demand the value.
#
#   Value completions are named `:label:action`; a label with no action means
#   free-form (a prompt, a JSON blob, a UUID). Positionals use `->state` only
#   when a subcommand's tail needs a second _arguments call.


# ---------------------------------------------------------------------------
# 1. Enumerations
# ---------------------------------------------------------------------------

local -a _claude_efforts=( low medium high xhigh max )
local -a _claude_permission_modes=( acceptEdits auto bypassPermissions manual dontAsk plan )
local -a _claude_permission_prompts=( host none )
local -a _claude_output_formats=( text json stream-json )
local -a _claude_input_formats=( text stream-json )
local -a _claude_setting_sources=( user project local )
local -a _claude_model_aliases=( fable opus sonnet haiku )
local -a _claude_mcp_scopes=( local user project )
local -a _claude_mcp_transports=( stdio sse http )
local -a _claude_plugin_scopes=( user project local )
local -a _claude_plugin_components=( skills agents hooks mcp lsp output-style channel )
local -a _claude_import_sources=( codex gemini cursor )
local -a _claude_install_targets=( stable latest )
local -a _claude_bools=( true false 1 0 yes no on off )


# ---------------------------------------------------------------------------
# 2. Dynamic lookups
# ---------------------------------------------------------------------------

# Where claude keeps state. modules/shell/claude.nix points this at
# ~/.local/share/claude; upstream's default is ~/.claude.
__claude_config_dir() { print -r -- ${CLAUDE_CONFIG_DIR:-$HOME/.claude} }

# Background sessions: the short ids that `claude --bg` prints and attach /
# logs / stop / rm / respawn consume. ~0.2s, no network. Each entry looks like
#   {"id":"bea29221","name":"...","state":"done","cwd":...,"sessionId":...}
# and _describe splits on the first bare colon, hence the gsub.
__claude_sessions() {
  local -a ids
  ids=( ${(f)"$(claude agents --json --all 2>/dev/null \
    | jq -r '.[] | "\(.id):\(.name // "" | gsub(":"; "\\:")) [\(.state)]"' 2>/dev/null)"} )
  _describe -t sessions 'background session' ids
}

# Sessions --resume can pick up in this directory. Transcripts live under
# projects/<cwd with every / and . turned into ->/<uuid>.jsonl; newest first
# because that's the one I want nine times in ten.
__claude_resumable() {
  local dir="$(__claude_config_dir)/projects/${${PWD//\//-}//./-}"
  local -a ids
  ids=( $dir/*.jsonl(Nom:t:r) )
  _describe -t sessions 'session in this project' ids
}

# MCP server names from the three scopes `mcp add -s` writes to, read directly
# so TAB skips the health check `claude mcp list` insists on (it round-trips
# every server). user and local both live in .claude.json; project is .mcp.json.
# claude.ai connectors aren't in any of these and won't complete.
__claude_mcp_servers() {
  local -a names
  local cfg="$(__claude_config_dir)/.claude.json"
  [[ -r $cfg ]] && names+=( ${(f)"$(jq -r --arg cwd $PWD \
    '(.mcpServers // {}), (.projects[$cwd].mcpServers // {}) | keys[]' $cfg 2>/dev/null)"} )
  [[ -r .mcp.json ]] && names+=( ${(f)"$(jq -r '.mcpServers // {} | keys[]' .mcp.json 2>/dev/null)"} )
  _describe -t servers 'mcp server' names
}

__claude_plugins() {
  local -a names
  names=( ${(f)"$(claude plugin list --json 2>/dev/null \
    | jq -r '.[] | (.id // .name // empty)' 2>/dev/null)"} )
  _describe -t plugins 'plugin' names
}

# `plugin marketplace list` has no --json; its names are the lines with the
# pointer glyph in front.
__claude_marketplaces() {
  local -a names
  names=( ${(f)"$(claude plugin marketplace list 2>/dev/null \
    | sed -n 's/^  ❯ //p')"} )
  _describe -t marketplaces 'marketplace' names
}

# Agent definitions: one markdown file per agent, project then user.
__claude_agents() {
  local -a names
  names=( .claude/agents/*.md(N:t:r) "$(__claude_config_dir)"/agents/*.md(N:t:r) )
  _describe -t agents 'agent' names
}

__claude_models() {
  _describe -t models 'model alias' _claude_model_aliases
}


