# --- claude mcp ------------------------------------------------------------

_claude_mcp() {
  local -a cmds=(
    'add:Add an MCP server'
    'add-from-claude-desktop:Import MCP servers from Claude Desktop (Mac and WSL only)'
    'add-json:Add an MCP server from a JSON string'
    'get:Get details about an MCP server'
    'list:List configured MCP servers'
    'login:Authenticate with an MCP server'
    'logout:Clear stored OAuth credentials for an MCP server'
    'remove:Remove an MCP server'
    'reset-project-choices:Reset approved/rejected .mcp.json servers in this project'
    'serve:Start the Claude Code MCP server'
  )
  _arguments -C '(-h --help)'{-h,--help}'[Display help]' '1: :->cmd' '*:: :->args'
  case $state in
    cmd) _describe -t commands 'mcp command' cmds ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '--callback-port[Fixed port for OAuth callback]:port:' \
            '--client-id[OAuth client ID for HTTP/SSE servers]:client id:' \
            '--client-secret[Prompt for OAuth client secret]' \
            '*'{-e,--env}'[Set environment variables (KEY=value)]:env:' \
            '*'{-H,--header}'[Set headers for HTTP/SSE servers]:header:' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Configuration scope (default local)]:scope:('"$_claude_mcp_scopes"')' \
            '(-t --transport)'{-t,--transport}'[Transport type (default stdio)]:transport:('"$_claude_mcp_transports"')' \
            '1:name:' \
            '2:command or url:_command_names -e' \
            '*:::args:_normal'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Configuration scope (default local)]:scope:('"$_claude_mcp_scopes"')'
          ;;
        add-json)
          _arguments \
            '--client-secret[Prompt for OAuth client secret]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Configuration scope (default local)]:scope:('"$_claude_mcp_scopes"')' \
            '1:name:' \
            '2:json:'
          ;;
        get|logout)
          _arguments '(-h --help)'{-h,--help}'[Display help]' '1:server:__claude_mcp_servers'
          ;;
        login)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--no-browser[Print the authorization URL instead of opening a browser]' \
            '1:server:__claude_mcp_servers'
          ;;
        remove)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Scope to remove from (default: wherever it is)]:scope:('"$_claude_mcp_scopes"')' \
            '1:server:__claude_mcp_servers'
          ;;
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Enable debug mode]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--verbose[Override the verbose setting]'
          ;;
        list|reset-project-choices)
          _arguments '(-h --help)'{-h,--help}'[Display help]'
          ;;
      esac
      ;;
  esac
}

# --- claude plugin ---------------------------------------------------------

_claude_plugin() {
  local -a cmds=(
    'details:Show a plugin'"'"'s component inventory and token cost'
    'disable:Disable an enabled plugin'
    'enable:Enable a disabled plugin'
    'eval:Run eval cases against a plugin and report scores'
    'init:Scaffold a new plugin'
    'new:Scaffold a new plugin'
    'install:Install a plugin from available marketplaces'
    'i:Install a plugin from available marketplaces'
    'list:List installed plugins'
    'marketplace:Manage Claude Code marketplaces'
    'prune:Remove auto-installed dependencies no longer needed'
    'autoremove:Remove auto-installed dependencies no longer needed'
    'tag:Create a {name}--v{version} git tag for a plugin release'
    'uninstall:Uninstall an installed plugin'
    'remove:Uninstall an installed plugin'
    'update:Update a plugin to the latest version'
    'validate:Validate a plugin or marketplace manifest'
  )
  _arguments -C '(-h --help)'{-h,--help}'[Display help]' '1: :->cmd' '*:: :->args'
  case $state in
    cmd) _describe -t commands 'plugin command' cmds ;;
    args)
      case $words[1] in
        details)
          _arguments '(-h --help)'{-h,--help}'[Display help]' '1:plugin:__claude_plugins'
          ;;
        disable)
          _arguments \
            '(-a --all 1)'{-a,--all}'[Disable all enabled plugins]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Installation scope (default auto-detect)]:scope:('"$_claude_plugin_scopes"')' \
            '1:plugin:__claude_plugins'
          ;;
        enable)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Installation scope (default auto-detect)]:scope:('"$_claude_plugin_scopes"')' \
            '1:plugin:__claude_plugins'
          ;;
        eval)       _claude_plugin_eval ;;
        init|new)
          _arguments \
            '--author[Author name (default git user.name)]:name:' \
            '--author-email[Author email (default git user.email)]:email:' \
            '--description[Manifest description]:text:' \
            '(-f --force)'{-f,--force}'[Overwrite an existing .claude-plugin/]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '*--with[Also scaffold these components]:component:('"$_claude_plugin_components"')' \
            '1:name:'
          ;;
        install|i)
          _arguments \
            '*--config[Set a userConfig option (key=value)]:key=value:' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Installation scope (default user)]:scope:('"$_claude_plugin_scopes"')' \
            '(-y --yes)'{-y,--yes}'[Accept the marketplace-declared command without prompting]' \
            '1:plugin@marketplace:'
          ;;
        list)
          _arguments \
            '--available[Include available plugins from marketplaces (requires --json)]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--json[Output as JSON]'
          ;;
        marketplace) _claude_plugin_marketplace ;;
        prune|autoremove)
          _arguments \
            '--dry-run[List what would be removed without removing]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Prune at scope (default user)]:scope:('"$_claude_plugin_scopes"')' \
            '(-y --yes)'{-y,--yes}'[Skip the confirmation prompt]'
          ;;
        tag)
          _arguments \
            '--dry-run[Print what would be tagged without creating it]' \
            '(-f --force)'{-f,--force}'[Skip the dirty-tree and tag-exists checks]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-m --message)'{-m,--message}'[Tag annotation message (%s for the version)]:message:' \
            '--push[Push the tag to --remote after creating it]' \
            '--remote[Remote to push to (default origin)]:remote:' \
            '1:plugin path:_directories'
          ;;
        uninstall|remove)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--keep-data[Preserve the plugin'"'"'s persistent data directory]' \
            '--prune[Also remove auto-installed dependencies no longer needed]' \
            '(-s --scope)'{-s,--scope}'[Uninstall from scope (default user)]:scope:('"$_claude_plugin_scopes"')' \
            '(-y --yes)'{-y,--yes}'[Skip the --prune confirmation prompt]' \
            '1:plugin:__claude_plugins'
          ;;
        update)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Installation scope (default user)]:scope:('"$_claude_plugin_scopes"' managed)' \
            '(-y --yes)'{-y,--yes}'[Accept the marketplace-declared command without prompting]' \
            '1:plugin:__claude_plugins'
          ;;
        validate)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--json[Output the validation report as JSON]' \
            '--strict[Treat warnings as errors]' \
            '1:path:_files'
          ;;
      esac
      ;;
  esac
}

# --- claude plugin marketplace --------------------------------------------
# Third level: flags unverifiable in this build (see HOW TO REGENERATE).

_claude_plugin_marketplace() {
  local -a cmds=(
    'add:Add a marketplace from a URL, path, or GitHub repo'
    'list:List all configured marketplaces'
    'remove:Remove a configured marketplace'
    'rm:Remove a configured marketplace'
    'update:Update marketplace(s) from their source'
  )
  _arguments -C '(-h --help)'{-h,--help}'[Display help]' '1: :->cmd' '*:: :->args'
  case $state in
    cmd) _describe -t commands 'marketplace command' cmds ;;
    args)
      case $words[1] in
        add)              _arguments '1:source (url, path, or owner/repo):_files' ;;
        remove|rm|update) _arguments '1:marketplace:__claude_marketplaces' ;;
      esac
      ;;
  esac
}

# --- claude plugin eval ----------------------------------------------------

_claude_plugin_eval() {
  # The target slot is a subcommand, a plugin name, or a path; _alternative
  # wants each branch as a bare function, so the one-entry command table gets
  # its own.
  __claude_eval_commands() {
    local -a cmds=( 'init:Author an eval suite under the eval dir via an interview' )
    _describe -t commands 'eval command' cmds
  }
  _arguments -C \
    '--ablation[Run a no-plugin baseline arm and report the delta]:mode:(none with-without)' \
    '*--allow-tools[Operator grant for gated tools]:tools:' \
    '--case[Filter cases by name glob]:glob:' \
    '--eval-dir[Directory below the plugin holding the eval cases]:dir:_directories' \
    '(-h --help)'{-h,--help}'[Display help]' \
    '--json=[Print or write the full run result as JSON]::file:_files -g "*.json"' \
    '--judge-model[Override LLM-grader model (default haiku)]:model:__claude_models' \
    '--keep-temp[Preserve scaffold dirs for debugging]' \
    '--max-cost-usd[Hard cost ceiling; abort with partial results if hit]:usd:' \
    '--mocks[Mock stand-ins for MCP servers]:mode:(record off)' \
    '--model[Override model for all cases]:model:__claude_models' \
    '(--publish-report)--no-publish[Keep the HTML report local only]' \
    '(--scaffold)--no-scaffold[Explicitly skip scaffold_script]' \
    '--output-dir[Directory for aggregate-result.json]:dir:_directories' \
    '(--no-publish)--publish-report[Require publishing the report to claude.ai]' \
    '--report[Write the self-contained HTML report here]:file:_files -g "*.html"' \
    '--runs[Override per-case runs (default 3)]:n:' \
    '(--no-scaffold)--scaffold[Run each case'"'"'s scaffold_script]' \
    '*--tag[Filter cases by tag]:tag:' \
    '--threshold[Exit 1 if any case scores below this]:0..1:' \
    '--verbose[Log per-message trace events to the debug log]' \
    '1: :->target' \
    '*:: :->args'
  case $state in
    target)
      _alternative \
        'commands:eval command:__claude_eval_commands' \
        'plugins:plugin:__claude_plugins' \
        'paths:plugin path:_directories'
      ;;
    args) [[ $words[1] == init ]] && _arguments '1:name:' ;;
  esac
}


# ---------------------------------------------------------------------------
# 6. Main body
# ---------------------------------------------------------------------------
# Not wrapped in a `_claude() { ... }` of its own, on purpose: compinit loads
# this whole file *as* _claude, and a nested definition would replace it after
# the first TAB, taking the `local` arrays above with it. The helpers above are
# (cheaply) redefined on every call for the same reason.
#
# `claude [options] [command] [prompt]`: the first bare word is a subcommand
# if it is in the table, and the start of a prompt otherwise -- in which case
# there is nothing to offer, and _arguments' free-form `prompt` says so.

local curcontext="$curcontext" state line
typeset -A opt_args

_arguments -C \
  $_claude_global_opts \
  '1: :->command' \
  '*:: :->args' && return 0

case $state in
  command)
    _alternative \
      'commands:claude command:_claude_commands' \
      'prompts:prompt: '
    ;;
  args)
    curcontext="${curcontext%:*:*}:claude-$words[1]:"
    case $words[1] in
      agents)          _claude_agents ;;
      attach)          _claude_attach ;;
      auth)            _claude_auth ;;
      auto-mode)       _claude_auto_mode ;;
      doctor)          _claude_doctor ;;
      gateway)         _claude_gateway ;;
      import)          _claude_import ;;
      install)         _claude_install ;;
      logs)            _claude_logs ;;
      mcp)             _claude_mcp ;;
      plugin|plugins)  _claude_plugin ;;
      project)         _claude_project ;;
      respawn)         _claude_respawn ;;
      rm)              _claude_rm ;;
      setup-token)     _claude_setup_token ;;
      stop|kill)       _claude_stop ;;
      ultrareview)     _claude_ultrareview ;;
      update|upgrade)  _claude_update ;;
      *)               _message 'prompt' ;;
    esac
    ;;
esac
