#compdef hey lab
#
# Almost nothing here is hardcoded. `hey help --dump [CMD]` supplies the
# subcommand list and each command's flags and arguments, generated from the
# OPTIONS: and ARGUMENTS: sections of its comment header, and `hey help --scan
# DIRS` describes the scripts in a directory. Both live in lib/hey/docs.janet.
#
# The generic half of all that -- dumping, scanning, walking script directories,
# the subcommand menu -- lives in lib/zsh as one autoloaded hey.comp.* function
# apiece (see modules/hey.nix), for any other zsh script to reach. The prefix is
# how to tell the two apart: hey.comp.* is public and anyone's to call, __hey_*
# is defined in this file and nobody else's business.
#
# The other names up there are bin/lab and bin/beval, which are
# `exec hey .NAME "$@"` and little else. Any such wrapper gets hey's completion
# by being named on that line (or with `compdef NAME _hey`); there is no
# per-wrapper file to write, because there is nothing to complete but what hey
# resolves .NAME to.
#
# What's left here is the dynamic half of hey's dispatcher, which has to walk
# /etc/dotfiles (or $DOTFILES_HOME, if set):
#
#   hey wm|host CMD        -- scripts in {config/$WM,hosts/$HOST}/bin (and
#                             bin/hey.d/wm.d, for wm)
#   hey ops CMD            -- scripts in bin/hey.d/ops.d
#   hey @FOO CMD           -- scripts in config/FOO/bin
#   hey .FOO               -- scripts in hosts/$HOST/bin, config/$WM/bin, or bin/
#   hey hook [@AREA] HOOK  -- hooks in the dirs info.json lists (hey.hookPaths)
#
# Script directories nest: a NAME.d (or NAME/) directory beside NAME is
# descended into, exactly like lib/hey/init.janet's resolve-1.
#
# compinit's _comp_setup already sets extendedglob, NO_globsubst and
# NO_shwordsplit for every completion, so nothing here needs its own setopt.
# It also declares `local -a reply`, which is why the results below go into
# $_hey_reply: zstyle -e assigns into the caller's $reply, so handing that name
# to _describe risks it being clobbered out from under us.

# The area DIR belongs to, left in $REPLY. Mirrors bin/hey.d/hook.janet's
# area-of, which is what decides whether @AREA means anything.
__hey_hook_area() {
  local dir=${1%/}
  if   [[ ${dir:t} != hooks ]];     then REPLY=${${dir:t}%.d}
  elif [[ ${dir:h:h:t} == hosts ]]; then REPLY=host
  else                                   REPLY=${dir:h:t}
  fi
}

# The areas a hook can be scoped to. Bare after an @, sigil-prefixed otherwise,
# so they can share a menu with the hook names.
__hey_hook_areas() {
  local -a areas=( $_hey_hookareas )
  (( $#areas )) || return 1
  compset -P '@' || areas=( ${areas/#/@} )
  _describe -t areas 'hook area' areas
}

# With no AREA, offers every area's hooks plus the areas themselves. A handler's
# NN- is its place in line, not its name, and several dirs can handle one hook.
__hey_hooks() {
  local area=${1-} dir name REPLY ret=1
  local -a dirs _hey_reply
  local -A seen

  [[ -z $area && $PREFIX == @* ]] && { __hey_hook_areas; return }

  for dir in $_hey_hookdirs; do
    __hey_hook_area $dir
    [[ -z $area || $REPLY == $area ]] && dirs+=( $dir )
  done
  if hey.comp.scan $dirs; then
    for name in ${_hey_reply/#<->-/}; do
      (( $+seen[${name%%:*}] )) || seen[${name%%:*}]=$name
    done
    _hey_reply=( ${(v)seen} )
  fi

  (( $#_hey_reply )) && { _describe -t hooks 'hook' _hey_reply && ret=0 }
  [[ -n $area ]] || { __hey_hook_areas && ret=0 }
  return ret
}

# hook takes an optional leading @AREA, which _arguments has no way to express
# as a positional. When position 1 swallowed one, the hook name lands here
# instead, as the first of the rest arguments.
__hey_hook_arg() {
  if [[ $CURRENT == 1 && $line[1] == @?* ]]; then
    __hey_hooks ${line[1]#@}
  else
    _default
  fi
}

__hey_path_segment() {
  if [[ $line[1] == xdg ]]; then
    local expl
    _wanted directories expl 'XDG directory' \
      compadd bin config data cache state runtime fake
  else
    _files
  fi
}

# One hitch: the stock _ssh_hosts completer can't deal with the PATH component
# in [user@]host[:PATH], so I gotta reinvent this wheel out of wheels
# that, fortunately, already exist (_remote_files, which _ssh uses).
#
# Turn it off with `zstyle ':completion:*:*:hey:*:files' remote-access false` if
# you don't like it. The directories-only syntax (-/) won't work here though.
__hey_ssh_target() {
  compset -P 1 '*:' && { _remote_files -- ssh; return }
  compset -P '*@'
  _hosts -qS:
}

# The host half of the above, for the commands that take somewhere to ssh to
# and no path to put things at (config/*/bin/infect.zsh).
__hey_ssh_host() {
  compset -P '*@'
  _hosts
}

# hey ops edit takes SYSTEM:FILE. I know the systems. The files are on a
# machine I am not about to hang a TAB on an ssh round trip to, so past the
# colon I have nothing to say and say it.
__hey_edit_target() {
  compset -P '*:' && return 1
  hey.comp.hosts ':'
}

__hey_generations() {
  local expl
  local -a gens=( /nix/var/nix/profiles/system-*-link(N:t:s/system-//:s/-link//) )
  (( $#gens )) && _wanted generations expl 'generation' compadd -o numeric -a gens
}

__hey_inputs() {
  local expl
  local -a inputs
  (( $+commands[jq] )) && [[ -r $_hey_root/flake.lock ]] &&
    inputs=( ${(f)"$(jq -r '.nodes.root.inputs | keys[]' -- $_hey_root/flake.lock 2>/dev/null)"} )
  (( $#inputs )) && _wanted inputs expl 'flake input' compadd -a inputs
}

# The Janet suites, named as bin/hey.d/test.janet's hey-suites names them: the
# path under test/, minus the .nix, with test/nixos and anything _-prefixed left
# out of it.
__hey_hey_suites() {
  local expl root=$_hey_root/test
  local -a suites=( $root/*/*.janet(N.) )
  suites=( ${${suites#$root/}%.janet} )
  suites=( ${suites:#(nixos|_*)/*} )
  suites=( ${suites:#*/_*} )
  (( $#suites )) && _wanted suites expl 'hey suite' compadd -a suites
}

# The NixOS suites, named as test/nixos/_lib.nix's collectSuites names them: the
# path under test/nixos, minus the .nix, with "/" turned into "-". Read off the
# filesystem, not from `hey test -l`, which evaluates the flake twice and is far
# too slow to hang a TAB on.
__hey_test_suites() {
  local expl root=$_hey_root/test/nixos
  local -a files suites
  files=( $root/**/*.nix(N.) )
  files=( ${files#$root/} )
  # collectSuites skips _private paths, NAME.d directories, and the default.nix
  # a directory is entered through.
  files=( ${files:#(*/|)(_*|default.nix)} )
  files=( ${files:#*.d/*} )
  suites=( ${${files%.nix}//\//-} )
  (( $#suites )) && _wanted suites expl 'nixos suite' compadd -a suites
}

__hey_info_keys() {
  local -a keys
  (( $+commands[jq] )) && [[ -r $_hey_datadir/info.json ]] &&
    keys=( ${(f)"$(jq -r 'keys[]' -- $_hey_datadir/info.json 2>/dev/null)"} )
  _alternative \
    'queries:query:((ip:"print this machine'"'"'s IP address"))' \
    'keys:info key:compadd -a keys'
}

__hey_vars() {
  local expl dir
  if (( $+opt_args[-g] )); then
    dir=$_hey_datadir/vars.d
  else
    dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/hey/vars.d
  fi
  local -a vars=( $dir/*(N.:t) )
  (( $#vars )) && _wanted vars expl 'variable' compadd -a vars
}

__hey_image_variants() {
  local expl
  local -a variants=(
    amazon azure cloudstack digital-ocean google-compute hyperv
    iso iso-installer kexec kubevirt linode lxc lxc-metadata
    oci openstack openstack-zfs proxmox proxmox-lxc
    qemu qemu-efi raw raw-efi sd-card vagrant-virtualbox virtualbox vmware
  )
  _wanted variants expl 'image variant' compadd -a variants
}

__hey_sync_arg() {
  case $line[1] in
    (rollback) __hey_generations ;;
    (build-image) (( $#line > 2 )) || __hey_image_variants ;;
    (*) _default ;;
  esac
}
__hey_profile_arg() { [[ $line[1] == (rm|diff) ]] && { __hey_generations; return }; return 1 }

# `test nixos SUITE` takes a single suite name; `test hey ARGS` passes its
# arguments to judge, which takes suite names or test files.
__hey_test_arg() {
  case $line[1] in
    (nix|nixos) (( $#line > 2 )) || __hey_test_suites ;;
    (hey) __hey_hey_suites; _files ;;
    (*) return 1 ;;
  esac
}

# For scripts that forward to a cobra CLI (docker, kubectl, gh, ...), which
# answer their own completion through a hidden `__complete ARGS... PREFIX`:
# `value<TAB>desc` lines, then a `:BITS` directive. Asking the script rather
# than the program means it gets asked wherever the script sends it, e.g. over
# ssh. By path, not through hey, which would eat any -h on the line.
__hey_cobra() {
  local script=${$(command $_hey_bin which $_hey_leaf 2>/dev/null)%%[[:space:]]#}
  [[ -x $script ]] || return 1
  local -a out opts
  out=( ${(f)"$($script __complete "${(@)words[1,CURRENT-1]}" "$PREFIX" 2>/dev/null)"} )
  [[ $out[-1] == :<-> ]] || return 1
  local -i bits=${out[-1]#:}
  out[-1]=()
  (( bits & 1 )) && return 1
  (( bits & 2 )) && opts=( -S '' )
  # Cobra's [ActiveHelp] lines aren't candidates.
  out=( ${out:#_activeHelp_*} )
  if (( $#out )); then
    local -a _hey_reply
    local l v
    # _describe splits on the first colon, and docker has plenty (image:tag).
    for l in $out; do
      v=${${l%%$'\t'*}//:/\\:}
      [[ $l == *$'\t'* ]] && v+=:${l#*$'\t'}
      _hey_reply+=( $v )
    done
    _describe -t cobra 'argument' _hey_reply "${(@)opts}"
  elif (( ! (bits & 4) )); then
    _default
  else
    return 1
  fi
}

# hey's dispatch rules that aren't "read the subcommand's header". Exit 2 hands
# the word back to hey.comp.dispatch, which does exactly that; every other status
# is an answer, even an empty one.
__hey_rules() {
  case $words[1] in
    # Paths are executed verbatim. This must precede (.*), which would
    # otherwise claim ./foo and search for a script named /foo.
    (./*|/*) _default ;;

    # These dispatch into a directory of scripts instead of taking arguments of
    # their own, so there is no header of their own to read.
    (host)  hey.comp.subdir $_hey_root/hosts/$_hey_host/bin ;;
    # hey wm's compiled commands come first, and shadow a script of the same
    # name, the way bin/hey.d/wm.janet's table does.
    (wm)    hey.comp.subdir $_hey_root/bin/hey.d/wm.d ${_hey_wm:+$_hey_root/config/$_hey_wm/bin} ;;
    (@*)    hey.comp.subdir $_hey_root/config/${words[1]#@}/bin ;;
    (ops)   hey.comp.subdir $_hey_root/bin/hey.d/ops.d ;;
    (.*)
      local _hey_sigil=.
      words[1]=${words[1]#.}
      hey.comp.scriptdir $_hey_bindirs
      ;;

    # Dispatch rules with no script of their own to read a header from. bin/hey
    # maps get/set to a lambda with no file, so --dump has nothing to emit.
    (exec)
      _arguments -C \
        '1:command:_command_names -e' \
        '*:: :_default'
      ;;
    (get|set)
      _arguments -C \
        '-g[read or write a persistent (global) var]' \
        '1: :__hey_vars'
      ;;

    (*) return 2 ;;
  esac
}

_hey() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a globals _hey_reply
  local _hey_bin=hey

  # `hey` resolves these internally (see lib/hey/lib.janet)
  local _hey_root=${DOTFILES_HOME:-/etc/dotfiles}
  local _hey_host=$HOST
  local _hey_wm=${${(M)${(L)XDG_CURRENT_DESKTOP}:#*hyprland*}:+hypr}
  local _hey_datadir=${XDG_DATA_HOME:-$HOME/.local/share}/hey
  # An unset $_hey_wm would collapse config/$_hey_wm/bin to config/bin, so it
  # has to drop out of the list entirely.
  local -a _hey_bindirs=(
    $_hey_root/hosts/$_hey_host/bin
    ${_hey_wm:+$_hey_root/config/$_hey_wm/bin}
    $_hey_root/bin
  )
  local -a _hey_cfgdirs=( $_hey_root/config/*/bin(N-/:h:t) )
  # Only what this host enables, courtesy of hey.hookPaths (see modules/hey.nix).
  local -a _hey_hookdirs _hey_hookareas
  (( $+commands[jq] )) &&
    _hey_hookdirs=( ${(f)"$(jq -r '.hooks[]?' $_hey_datadir/info.json 2>/dev/null)"} )
  local REPLY dir
  for dir in $_hey_hookdirs; do
    __hey_hook_area $dir
    _hey_hookareas+=( $REPLY )
  done
  _hey_hookareas=( ${(u)_hey_hookareas} )

  # Anything else this is compdef'd onto is a `hey .NAME "$@"` wrapper, so hand
  # the line to the .* rule and let it walk. $service rather than $words[1],
  # which is whatever spelling of the command I happened to type.
  if [[ $service != hey ]]; then
    local _hey_sigil=.
    words[1]=$service
    hey.comp.scriptdir $_hey_bindirs
    return
  fi

  # hey's own flags come from bin/hey's header, like every other command's. By
  # absolute path, not `.hey`, which would resolve through the search path and
  # let a script named `hey` in an earlier bin/ shadow it.
  hey.comp.dump $_hey_root/bin/hey && globals=( $_hey_reply )

  _arguments -C -A '-*' \
    $globals \
    '1: :hey.comp.commands' \
    '*:: :->args' && return 0

  [[ $state == args ]] || return 1
  hey.comp.dispatch
}

_hey "$@"
