#!/usr/bin/env zsh
# Pop a one-line OSD.
#
# SYNOPSIS:
#   hey.toast [-i GLYPH] [-p FRACTION] [-m] (info|warn|error) TEXT
#
# DESCRIPTION:
#   Send a Noctalia toast using its new OSD API. One line, no body, no image,
#   gone in a moment, never filed in the control center. Anything that needs
#   more than that should use hey.notify.
#
# OPTIONS:
#   -i GLYPH
#     A tabler glyph name. Defaults to one per type. Won't recognize image paths.
#   -m
#     The muted look, for "ended" and "nothing there".
#   -p FRACTION
#     A progress bar, 0 to 1.

local -a glyph progress muted
zparseopts -D -- i:=glyph p:=progress m=muted
local type=$1 text=$2
local -A glyphs=( info info-circle warn alert-triangle error circle-x )

hey.do -o noctalia msg osd-show \
    "$(jq -cn --arg i "${glyph[2]:-${glyphs[$type]:-$glyphs[info]}}" --arg v "$text" \
              --argjson p "${progress[2]:-null}" --argjson m "${#muted}" \
          '{ icon: $i, value: $v }
           + (if $p != null then { progress: $p } else {} end)
           + (if $m > 0 then { inactive: true } else {} end)')"
