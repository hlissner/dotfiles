#!/usr/bin/env zsh
# Executed at startup
#
# SYNOPSIS:
#   hey hook on-started
#
# DESCRIPTION:
#   Fired by noctalia's `started` hook.

# empty-workspace-above-first parks an empty workspace above home, and that's
# where niri starts; home is where I do.
hey.do niri msg action focus-workspace home

# For persisted window rules generated by `hey wm launch`
rm -f ${XDG_CONFIG_HOME:-$HOME/.config}/niri/launch.kdl

hey wm play-sound startup
