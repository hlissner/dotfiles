// Auto-generated by Matugen; see config/zellij/themes/colors.kdl
//
// The theme name has to match `theme "colors"` in config.kdl, and zellij wants
// every one of these eleven keys! A partial theme is an error!
themes {
    colors {
        fg "{{colors.on_surface.default.hex}}"
        bg "{{colors.surface.default.hex}}"
        black "{{colors.surface_container_lowest.default.hex}}"
        red "{{colors.error.default.hex}}"
        green "{{colors.tertiary.default.hex}}"
        yellow "{{colors.secondary.default.hex}}"
        blue "{{colors.primary.default.hex}}"
        magenta "{{colors.tertiary_container.default.hex}}"
        cyan "{{colors.secondary_container.default.hex}}"
        white "{{colors.on_surface_variant.default.hex}}"
        orange "{{colors.error_container.default.hex}}"
    }
}
