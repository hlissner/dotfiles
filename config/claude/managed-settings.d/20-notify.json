{
  "preferredNotifChannel": "terminal_bell",

  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|worker_permission_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "hey @claude notify"
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "hey @claude notify"
          }
        ]
      }
    ]
  }
}
