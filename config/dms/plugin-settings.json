{
  "timer": {
    "systemActionOnTimeout": "custom",
    "customCommandOnTimeout": "hey .play-sound alarm",
    "showPillIcon": true,
    "showReadyPlaceholder": false,
    "displayFormat": "minimal"
  },
  "peripheralBattery": {
    "deviceIcons": [
      { "match": "magic trackpad", "icon": "touch_app", "color": "" },
      { "match": "magic keyboard", "icon": "keyboard", "color": "" }
    ],
    "deviceFilter": [],
    "showLabels": false,
    "warnThreshold": 20,
    "criticalThreshold": 15,
    "meterThreshold": 60,
    "notifyCritical": true,
    "hideWhenEmpty": true
  },
  "hyprlandSubmapIndicator": {
    "submapIcons": [
      { "submap": "screenshot", "icon": "linked_camera", "color": "" },
      { "submap": "screencap", "icon": "camera_roll", "color": "" },
      { "submap": "session", "icon": "window", "color": "" }
    ],
    "submapLabels": [
      { "submap": "screenshot", "label": ".", "color": "" }
    ],
    "fontSize": "none"
  }
}
